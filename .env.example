# Copy this file to .env and adjust the values for your machine:
#   cp .env.example .env
# Every key is optional; the value shown is the default used when the key is missing.

# --- Server ---
SERVER_PORT=8081

# --- Database (PostgreSQL) ---
# Format: postgres://<user>:<password>@<host>:<port>/<database>?sslmode=disable
DATABASE_URL=postgres://analytics:analytics@localhost:5432/analytics_aggregator?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=5
DB_MAX_IDLE_TIME=300
DB_MAX_LIFE_TIME=1800
DB_HEALTH_CHECK_PERIOD=60

# --- Paging ---
PAGING_LIMIT_DEFAULT=10
PAGING_LIMIT_MAX=100

# --- Pipeline ---
GEO_API_BASE_URL=http://ip-api.com
ENRICHER_WORKER_SIZE=2
INSERT_BATCH_SIZE=5
PIPELINE_JOB_SIZE=50
# SECOND | MINUTE | anything else = MILLISECOND
BACKOFF_MULTIPLIER=SECOND
